      <Get Name="Get" Id="{b81159c7-5fe0-473d-b8c0-bce9a4c7bec3}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[InstanceName := _InstanceName;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>
